---
import "katex/dist/katex.min.css";
import BaseLayout from "./BaseLayout.astro";
import type { NavKey, NavLink, SearchIndexItem } from "../components/types";

interface ArticleNavItem {
  label: string;
  title: string;
  href: string;
}

interface TocItem {
  href: string;
  label: string;
  depth: number;
}

interface LicenseInfo {
  label: string;
  href: string;
}

interface Props {
  title: string;
  description?: string;
  eyebrow?: string;
  meta?: string[];
  toc?: TocItem[];
  previous?: ArticleNavItem;
  next?: ArticleNavItem;
  canonicalPath?: string;
  image?: string;
  currentNav?: NavKey | string;
  navLinks?: NavLink[];
  searchItems?: SearchIndexItem[];
  siteName?: string;
  siteUrl?: string;
  publishedAt?: string | Date;
  updatedAt?: string | Date;
  tags?: string[];
  authorName?: string;
  structuredData?: Record<string, unknown>;
  license?: LicenseInfo | null;
}

const {
  title,
  description,
  eyebrow,
  meta = [],
  toc = [],
  previous,
  next,
  currentNav = "posts",
  navLinks,
  searchItems,
  canonicalPath,
  image,
  siteName,
  siteUrl,
  publishedAt,
  updatedAt,
  tags = [],
  authorName = "Oops",
  structuredData,
  license = {
    label: "CC BY-NC-SA 4.0",
    href: "https://creativecommons.org/licenses/by-nc-sa/4.0/deed.zh",
  },
} = Astro.props;

const iso = (value: string | Date | undefined) => value ? new Date(value).toISOString() : undefined;
const publishedIso = iso(publishedAt);
const updatedIso = iso(updatedAt ?? publishedAt);
const canonical = canonicalPath ? new URL(canonicalPath, `${siteUrl ?? Astro.site?.toString() ?? Astro.url.origin}/`).toString() : Astro.url.toString();
const articleJsonLd = structuredData ?? {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: title,
  description,
  author: { "@type": "Person", name: authorName },
  datePublished: publishedIso,
  dateModified: updatedIso,
  keywords: tags,
  mainEntityOfPage: canonical,
  image,
};

const formatDay = (value: string | Date | undefined) => value
  ? new Date(value).toLocaleDateString("zh-CN", { year: "numeric", month: "long", day: "numeric" })
  : undefined;
const publishedLabel = formatDay(publishedAt);
const updatedLabel = updatedAt ? formatDay(updatedAt) : undefined;
const showUpdated = Boolean(updatedLabel && updatedLabel !== publishedLabel);

// Depth 2 is the outermost level the TOC renders, so indentation starts at zero.
const minTocDepth = toc.length > 0 ? Math.min(...toc.map((item) => item.depth)) : 2;
---

<BaseLayout
  title={title}
  description={description}
  canonicalPath={canonicalPath}
  image={image}
  currentNav={currentNav}
  navLinks={navLinks}
  searchItems={searchItems}
  siteName={siteName}
  siteUrl={siteUrl}
  ogType="article"
>
  <Fragment slot="head">
    {publishedIso && <meta property="article:published_time" content={publishedIso} />}
    {updatedIso && <meta property="article:modified_time" content={updatedIso} />}
    {authorName && <meta property="article:author" content={authorName} />}
    {tags.map((tag) => <meta property="article:tag" content={tag} />)}
    <meta name="pagefind:title" content={title} />
    {description && <meta name="pagefind:description" content={description} />}
    <script is:inline type="application/ld+json" set:html={JSON.stringify(articleJsonLd)} />
  </Fragment>
  <div class="reading-progress" aria-hidden="true"></div>

  <header class="article-header">
    <div class="article-column">
      {eyebrow && <p class="article-kicker" data-enter>{eyebrow}</p>}
      <h1 class="article-title" data-enter data-pagefind-meta="title" style="--delay:80ms">{title}</h1>
      {description && <p class="article-deck" data-enter data-pagefind-meta="description" style="--delay:150ms">{description}</p>}
      {meta.length > 0 && (
        <div class="article-meta" data-enter style="--delay:220ms">
          {meta.map((item) => <span class="article-meta-item">{item}</span>)}
        </div>
      )}
    </div>
  </header>

  <div class="article-main">
    {toc.length > 0 && (
      <aside class="toc" aria-label="文章目录" data-pagefind-ignore>
        <p class="toc-heading">本页目录</p>
        <nav class="toc-list">
          {toc.map((item) => (
            <a
              class="toc-link"
              href={item.href}
              data-toc-depth={Math.min(3, Math.max(0, item.depth - minTocDepth))}
            >
              <span class="toc-rule" aria-hidden="true"></span>
              <span class="toc-label">{item.label}</span>
            </a>
          ))}
        </nav>
      </aside>
    )}

    <article class="article-column article-body">
      <slot />
    </article>

    <footer class="article-end article-column" data-pagefind-ignore>
      {tags.length > 0 && (
        <ul class="article-tags">
          {tags.map((tag) => <li>{tag}</li>)}
        </ul>
      )}

      <dl class="article-license">
        <div><dt>标题</dt><dd>{title}</dd></div>
        <div><dt>作者</dt><dd>{authorName}</dd></div>
        {publishedLabel && <div><dt>发布</dt><dd>{publishedLabel}</dd></div>}
        {showUpdated && <div><dt>更新</dt><dd>{updatedLabel}</dd></div>}
        <div><dt>链接</dt><dd><a href={canonical}>{canonical}</a></dd></div>
        {license && (
          <div>
            <dt>许可</dt>
            <dd><a href={license.href} rel="license noopener noreferrer" target="_blank">{license.label}</a></dd>
          </div>
        )}
      </dl>
    </footer>

    {(previous || next) && (
      <nav class="article-nav article-column" aria-label="文章导航">
        {previous
          ? (
            <a class="article-nav-card" href={previous.href} data-direction="prev">
              <small>{previous.label}</small>
              <strong>{previous.title}</strong>
            </a>
          )
          : <span />}
        {next
          ? (
            <a class="article-nav-card" href={next.href} data-direction="next">
              <small>{next.label}</small>
              <strong>{next.title}</strong>
            </a>
          )
          : <span />}
      </nav>
    )}
  </div>
</BaseLayout>
