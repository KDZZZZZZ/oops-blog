---
import BaseLayout from "@/layouts/BaseLayout.astro";
import EssayStream from "@/components/EssayStream.astro";
import { getPageContext } from "@/lib/page-context";
import type { EssayItem } from "@/components/types";

const ctx = await getPageContext();

const essayItems: EssayItem[] = ctx.essays.map((essay) => ({
  id: essay.slug,
  title: essay.title,
  body: essay.body,
  topic: essay.topic,
  sourceNote: essay.sourceNote,
  href: essay.url,
  shares: essay.shares,
}));
---

<BaseLayout
  title="随笔"
  description="工程现场、实验片段与未长成文章的短记。"
  canonicalPath="/essays/"
  currentNav="essays"
  navLinks={ctx.navLinks}
  searchItems={ctx.searchItems}
  searchPlaceholder="搜索随笔"
  footerGroups={ctx.footerGroups}
>
  <section class="page-hero compact-hero essay-hero shell">
    <div class="page-hero-grid">
      <h1 class="display page-title-sm" data-enter>随笔</h1>
    </div>
  </section>

  <EssayStream
    essays={essayItems}
    closing="像鸟一样轻，而不是像羽毛。"
    closingSource="瓦莱里 · 卡尔维诺《新千年文学备忘录》引"
  />
</BaseLayout>
