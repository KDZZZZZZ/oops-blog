---
import BaseLayout from "@/layouts/BaseLayout.astro";
import ManuscriptTabs from "@/components/ManuscriptTabs.astro";
import { getPageContext } from "@/lib/page-context";
import {
  buildPostTimeline,
  buildRecentSixMonthUpdateSeries,
  getStatusLabel,
} from "@/lib/content";
import type {
  CategoryStat,
  ManuscriptOverview,
  TimelineItem,
  UpdateStat,
} from "@/components/types";

const ctx = await getPageContext();

const timeline = buildPostTimeline(ctx.allPosts);
const updateSeries = buildRecentSixMonthUpdateSeries(ctx.allPosts);

const timelineItems: TimelineItem[] = timeline.flatMap((month) =>
  month.posts.map((post) => ({
    id: `post-${post.slug}`,
    title: post.title,
    href: post.url,
    category: post.category,
    status: getStatusLabel(post.status),
    dateLabel: month.label,
    datetime: post.publishedAt.toISOString().slice(0, 10),
    muted: post.status !== "published",
  })),
);

const categoryStat: CategoryStat[] = ctx.categoryCounts.map((stat) => ({
  label: stat.category,
  value: stat.count,
}));

const maxUpdate = Math.max(1, ...updateSeries.map((p) => p.count));
const updateStat: UpdateStat[] = updateSeries.map((point, index) => ({
  label: point.label,
  value: point.count,
  max: maxUpdate,
  current: index === updateSeries.length - 1,
}));

const overview: ManuscriptOverview = {
  categoryStats: categoryStat,
  updateStats: updateStat,
  categoryCaption: "按门类",
  updateCaption: "近六个月",
  categoryNote: `共 ${ctx.posts.length} 篇 · ${categoryStat.length} 个门类，一点即一篇。`,
  chartNote: "只统计已公开的正文，不含草稿。",
};
---

<BaseLayout
  title="文稿"
  description="编年、门类、全览，三种方式浏览全部文稿。"
  canonicalPath="/posts/"
  currentNav="posts"
  navLinks={ctx.navLinks}
  postsNavPreview={ctx.postsPreview}
  searchItems={ctx.searchItems}
  searchPlaceholder="搜索文稿"
  footerGroups={ctx.footerGroups}
>
  <section class="page-hero compact-hero shell manuscript-hero">
    <div class="page-hero-grid">
      <h1 class="display page-title-sm" data-enter>文稿</h1>
    </div>
  </section>

  <ManuscriptTabs
    timeline={timelineItems}
    categories={ctx.categoryGroups}
    overview={overview}
    year={new Date().getFullYear()}
    timelineCountLabel={`共 ${timelineItems.length} 篇`}
    searchLabel="搜索文稿"
  />
</BaseLayout>
