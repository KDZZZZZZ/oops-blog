---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getPageContext } from "@/lib/page-context";

const ctx = await getPageContext();
---

<BaseLayout
  title="页面未找到"
  description="你访问的页面不存在。"
  canonicalPath="/"
  currentNav={undefined}
  navLinks={ctx.navLinks}
  searchItems={ctx.searchItems}
  footerGroups={ctx.footerGroups}
>
  <section class="page-hero compact-hero shell">
    <div class="page-hero-grid">
      <h1 class="display" data-enter>404</h1>
    </div>
  </section>
  <section class="section shell">
    <div class="prose reveal">
      <p class="epigraph">寻向所志，遂迷，不复得路。</p>
      <p>你访问的页面不存在。可能是链接已失效，或者从未存在过。</p>
      <p><a href="/">返回首页</a>，或前往<a href="/posts/">文稿归档</a>浏览全部内容。</p>
    </div>
  </section>
</BaseLayout>
