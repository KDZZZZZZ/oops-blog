---
import { FlaskConical, Quote, Sprout, Users } from "@lucide/astro";
import SketchIcon, { type SketchIconName } from "./SketchIcon.astro";
import type { CategoryGroup, NavLink, NavKey, SocialLink } from "./types";

interface HomePreview {
  avatarSrc?: string;
  siteName?: string;
  presence?: string;
  counts?: Array<{ label: string; value: string | number }>;
  note?: string;
  socialLinks?: SocialLink[];
}

interface PostsPreview {
  categories?: CategoryGroup[];
  footerHref?: string;
  footerLabel?: string;
}

interface Props {
  links: NavLink[];
  current?: NavKey | string;
  homePreview?: HomePreview;
  postsPreview?: PostsPreview;
}

const { links, current, homePreview, postsPreview } = Astro.props;
const activePostCategory = postsPreview?.categories?.[0];
const moreIcons = [Users, FlaskConical, Quote, Sprout];
const primaryLinks = links.filter((item) => ["home", "posts", "essays", "more"].includes(String(item.key)));
---

<nav class="desktop-nav" aria-label="主导航" data-od-id="path-1-0-1">
  {
    primaryLinks.map((link) => {
      const iconName = String(link.key) as SketchIconName;

      if (link.key === "home" && homePreview) {
        return (
          <span class="nav-pod nav-pod-home">
            <a href={link.href} aria-current={link.key === current ? "page" : undefined}>
              <SketchIcon name={iconName} class="nav-primary-icon" />
              <span class="nav-label">{link.label}</span>
            </a>
            <div class="nav-preview nav-preview-home" aria-label="首页快捷入口">
              <section class="home-profile-card">
                {homePreview.avatarSrc && <img src={homePreview.avatarSrc} alt={`${homePreview.siteName ?? "Oops"} 的头像`} />}
                <strong>{homePreview.siteName ?? "Oops"}</strong>
                {homePreview.presence && <span class="presence"><i aria-hidden="true" />{homePreview.presence}</span>}
                {homePreview.counts && (
                  <dl class="profile-counts">
                    {homePreview.counts.map((item) => <div><dt>{item.label}</dt><dd>{item.value}</dd></div>)}
                  </dl>
                )}
                {homePreview.note && <p>{homePreview.note}</p>}
                {homePreview.socialLinks && (
                  <div class="profile-links" aria-label="联系方式">
                    {homePreview.socialLinks.map((item) => (
                      <a href={item.href} target={item.href.startsWith("http") ? "_blank" : undefined} rel={item.href.startsWith("http") ? "noreferrer" : undefined} aria-label={item.label}>
                        {item.shortLabel ?? item.label}
                      </a>
                    ))}
                  </div>
                )}
              </section>
            </div>
          </span>
        );
      }

      if (link.key === "posts" && postsPreview?.categories?.length) {
        return (
          <span class="nav-pod nav-pod-posts">
            <a href={link.href} aria-current={link.key === current ? "page" : undefined}>
              <SketchIcon name={iconName} class="nav-primary-icon" />
              <span class="nav-label">{link.label}</span>
            </a>
            <div class="nav-preview nav-preview-posts" aria-label="文稿预览">
              <section class="post-categories" role="tablist" aria-label="文稿门类" aria-orientation="vertical">
                <span class="preview-label">门类</span>
                {postsPreview.categories.map((category, index) => (
                  <button
                    class:list={[index === 0 && "is-active"]}
                    type="button"
                    role="tab"
                    aria-selected={index === 0 ? "true" : "false"}
                    aria-controls={`post-panel-${category.label}`}
                    tabindex={index === 0 ? "0" : "-1"}
                    data-post-category={category.label}
                  >
                    <b>{category.label}</b><small>{category.count}</small>
                  </button>
                ))}
              </section>
              <div class="post-panels">
                {postsPreview.categories.map((category, index) => (
                  <section
                    class:list={["recent-posts", index === 0 && "is-active"]}
                    id={`post-panel-${category.label}`}
                    role="tabpanel"
                    aria-label={`${category.label}门类的文稿`}
                    data-post-panel={category.label}
                    hidden={index !== 0}
                  >
                    <span class="preview-label">{category.label}</span>
                    {category.entries.map((entry) => entry.href && (
                      <a href={entry.href}><b>{entry.title}</b></a>
                    ))}
                  </section>
                ))}
              </div>
              {postsPreview.footerHref && (
                <a class="posts-preview-foot" href={postsPreview.footerHref}>
                  <span>{postsPreview.footerLabel ?? "查看全部文稿"}</span>
                  <span data-post-preview-count>{activePostCategory?.label} · {activePostCategory?.count ?? 0} 篇</span>
                </a>
              )}
            </div>
          </span>
        );
      }

      if (link.key === "more") {
        const moreLinks = links.filter((item) => item.key && !["home", "posts", "essays", "more"].includes(String(item.key)) && item.href);
        return link.disabled || !moreLinks.length ? (
          <span class="nav-pod">
            <span class="nav-disabled" aria-disabled="true" title={link.description}>
              <SketchIcon name={iconName} class="nav-primary-icon" />
              <span class="nav-label">{link.label}</span>
            </span>
          </span>
        ) : (
          <span class="nav-pod nav-pod-more">
            <button class="nav-trigger" type="button" aria-haspopup="menu">
              <SketchIcon name={iconName} class="nav-primary-icon" />
              <span class="nav-label">{link.label}</span>
            </button>
            <div class="nav-preview nav-preview-more" role="menu" aria-label="更多页面">
              {moreLinks.map((item, index) => {
                const Icon = moreIcons[index % moreIcons.length];
                return (
                  <a href={item.href} role="menuitem">
                    <Icon aria-hidden="true" />
                    <span><b>{item.label}</b>{item.description && <small>{item.description}</small>}</span>
                  </a>
                );
              })}
            </div>
          </span>
        );
      }

      return (
        <span class="nav-pod">
          {link.disabled || !link.href ? (
            <span class="nav-disabled" aria-disabled="true" title={link.description}>
              <SketchIcon name={iconName} class="nav-primary-icon" />
              <span class="nav-label">{link.label}</span>
            </span>
          ) : (
            <a href={link.href} aria-current={link.key === current ? "page" : undefined}>
              <SketchIcon name={iconName} class="nav-primary-icon" />
              <span class="nav-label">{link.label}</span>
            </a>
          )}
        </span>
      );
    })
  }
</nav>
