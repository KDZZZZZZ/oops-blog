---
import type { NavLink } from "./types";

interface Props {
  siteName?: string;
  year?: number;
  groups?: Array<{ label: string; links: NavLink[] }>;
}

const {
  siteName = "Oops",
  year = new Date().getFullYear(),
  groups = [],
} = Astro.props;

const footerLinks = groups.flatMap((group) => group.links).filter((link) => link.href);
---

<footer class="site-footer" data-pagefind-ignore>
  <span class="footer-copyright">© {year} {siteName}</span>
  <nav class="footer-links" aria-label="页脚导航">
    {footerLinks.map((link) => <a href={link.href}>{link.label}</a>)}
  </nav>
</footer>
