---
import type { EntryItem, EssayItem } from "./types";

interface Props {
  posts: EntryItem[];
  essays?: EssayItem[];
  title?: string;
  essayTitle?: string;
  id?: string;
}

const {
  posts,
  essays = [],
  title = "近期笔墨",
  essayTitle = "碎念",
  id = "home-feed",
} = Astro.props;

// 随笔若带分享，在碎念里露出一行线索（音乐给音符，影视书籍用书名号）
function shareHint(essay: EssayItem): string | undefined {
  const share = essay.shares?.find((item) => item.type !== "text");
  if (!share) return undefined;
  if (share.type === "music") return `♪ ${share.title} · ${share.artist}`;
  if (share.type === "link") return share.title;
  return `《${share.title}》`;
}
---

<section class="home-feed shell" id={id}>
  <div class="home-writing reveal">
    <header class="home-section-title">
      <div><h2>{title}</h2></div>
    </header>
    <ol class="home-writing-list">
      {
        posts.map((post, index) => (
          <li>
            <span class="writing-index">{String(index + 1).padStart(2, "0")}</span>
            <a href={post.href}>
              <h3>{post.title}</h3>
              {(post.category || post.side) && <small>{post.category ?? post.side}</small>}
            </a>
          </li>
        ))
      }
    </ol>
  </div>

  {essays.length > 0 && (
    <aside class="home-side reveal" aria-label="近期随笔与当前状态">
      <section class="home-musing">
        <header class="home-section-title">
          <div><h2>{essayTitle}</h2></div>
        </header>
        {essays.map((essay) => (
          <a class="musing-item" href={essay.href}>
            <strong class="musing-title">{essay.title}</strong>
            <p>{essay.body}</p>
            {shareHint(essay) && <span class="musing-share">{shareHint(essay)}</span>}
            {(essay.topic || essay.sourceNote) && <time>{essay.topic ?? essay.sourceNote}</time>}
          </a>
        ))}
      </section>
    </aside>
  )}
</section>
